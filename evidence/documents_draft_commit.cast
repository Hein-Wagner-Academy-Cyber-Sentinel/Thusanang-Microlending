[4701.494142, "o", "\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m# Project Charter — \u001b(B\u001b[0m\u001b[36m<Persona name>\r\u001b[4d\u001b[32m_Complete this in Phase 1._\r\u001b[6d\u001b(B\u001b[0;1m\u001b[33m## Scope\r\u001b[7d\u001b(B\u001b[0m\u001b[32m_What this platform will and will not do._\r\u001b[9d\u001b(B\u001b[0;1m\u001b[33m## Success criteria\r\u001b[10d\u001b(B\u001b[0m\u001b[32m_How we will know the platform is good enough._\r\u001b[12d\u001b(B\u001b[0;1m\u001b[33m## Assumptions\r\u001b[13d\u001b(B\u001b[0m\u001b[32m_What we are taking as given._\r\u001b[15d\u001b(B\u001b[0;1m\u001b[33m## Out of scope\r\u001b[16d\u001b(B\u001b[0m\u001b[32m_What we are deliberately not doing this year._\r\u001b[2d\u001b[39m\u001b(B\u001b[m\u001b[?12l\u001b[?25h"]
