[651.813877, "o", "\u001b[39;49m\u001b(B\u001b[m\u001b[H\u001b[2J\u001b[28;54H\u001b(B\u001b[0;7m[ Reading... ]\u001b(B\u001b[m"]
[651.817809, "o", "\u001b[28;52H\u001b(B\u001b[0;7m[ Read 58 lines ]\u001b(B\u001b[m"]
[651.81822, "o", "\u001b[H\u001b(B\u001b[0;7m  GNU nano 8.7.1                                           README.md                                                    \u001b[1;119H\u001b(B\u001b[m\r\u001b[29d\u001b(B\u001b[0;7m^G\u001b(B\u001b[m Help\u001b[29;16H\u001b(B\u001b[0;7m^O\u001b(B\u001b[m Write Out   \u001b(B\u001b[0;7m^F\u001b(B\u001b[m Where Is    \u001b(B\u001b[0;7m^K\u001b(B\u001b[m Cut\u001b[29;61H\u001b(B\u001b[0;7m^T\u001b(B\u001b[m Execute     \u001b(B\u001b[0;7m^C\u001b(B\u001b[m Location    \u001b(B\u001b[0;7mM-U\u001b(B\u001b[m Undo\u001b[106G\u001b(B\u001b[0;7mM-A\u001b(B\u001b[m Set Mark\r\u001b[30d\u001b(B\u001b[0;7m^X\u001b(B\u001b[m Exit\u001b[30;16H\u001b(B\u001b[0;7m^R\u001b(B\u001b[m Read File   \u001b(B\u001b[0;7m^\\\u001b(B\u001b[m Replace     \u001b(B\u001b[0;7m^U\u001b(B\u001b[m Paste\u001b[61G\u001b(B\u001b[0;7m^J\u001b(B\u001b[m Justify     \u001b(B\u001b[0;7m^/\u001b(B\u001b[m Go To Line  \u001b(B\u001b[0;7mM-E\u001b(B\u001b[m Redo\u001b[106G\u001b(B\u001b[0;7mM-6\u001b(B\u001b[m Copy"]
[651.818725, "o", "\r\u001b[2d\u001b(B\u001b[0;1m\u001b[33m#/ Build It Anywhere — Pair Project Repository\r\u001b[4d\u001b[39m\u001b(B\u001b[m/\u001b(B\u001b[0;1m\u001b[32m**Cyber Sentinel Programme, Cohort 3, Year 2 — Hein Wagner Academy**\r\u001b[6d\u001b[39m\u001b(B\u001b[mThis is your pair's project repository for the whole year. It \u001b(B\u001b[0;1m\u001b[32m**is**\u001b[39m\u001b(B\u001b[m your portfolio: everything you build, secure, and \u001b(B\u001b[0;7m>\u001b[8;1H\u001b(B\u001b[mReplace the placeholders below in your first Friday (Phase 1), then commit.\r\u001b[10d\u001b(B\u001b[0;1m\u001b[33m---\r\u001b[12d## Our pair\r\u001b[14d"]
[651.818937, "o", "\u001b[35m- \u001b[32m**Persona:**\u001b[39m\u001b(B\u001b[m \u001b[32m_Thusanang Microlending_\r\u001b[15d\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**Student A:**\u001b[39m\u001b(B\u001b[m \u001b[32m_Yanga Tutshana_\r\u001b[16d\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**Student B:**\u001b[39m\u001b(B\u001b[m \u001b[32m_Hattinie Freyer_\r\u001b[17d\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**The platform in one paragraph:**\u001b[39m\u001b(B\u001b[m \u001b[32m_We are building a cloud architexture solution for Thusanang Microlending, a micro\u001b[39m\u001b(B\u001b[0;7m>\u001b[19;1H\u001b(B\u001b[0;1m\u001b[33m## Phase 1 Roles\r\u001b[20d\u001b[35m* \u001b[32m**Build Lead:**\u001b[39m\u001b(B\u001b[m Hattinie Freyer (Owns infrastructure code, container definitions, toolchain setup, and pipeline confi\u001b(B\u001b[0;7m>\u001b[21;1H\u001b(B\u001b[0;1m\u001b[35m* \u001b[32m**Assurance Lead:**\u001b[39m\u001b(B\u001b[m Yanga Tutshana (Owns threat modeling, scanner findings and remediation, runbooks, and evidence re\u001b(B\u001b[0;7m>\u001b[23;1H"]
[651.819161, "o", "\u001b(B\u001b[0;1m\u001b[33m## How this repository is organised\r\u001b[25d\u001b[39m\u001b(B\u001b[mEvery folder has its own \u001b(B\u001b[0;1m\u001b[36m`README.md`\u001b[39m\u001b(B\u001b[m explaining exactly what belongs in it. In order of the year:\r\u001b[27d\u001b(B\u001b[0;1m\u001b[35m- \u001b[32m**charter/**\u001b[39m\u001b(B\u001b[m — your project charter, business profile, and POPIA exposure assessment (Phase 1)\r\u001b[2d\u001b[?12l\u001b[?25h"]
[660.064492, "o", "\u001b[?25l\u001b[28d\u001b[J\u001b[30d\u001b[?12l\u001b[?25h\u001b[30;1H\u001b[?1049l\u001b[23;0;0t\r\u001b[?1l\u001b>\u001b[?2004l"]
